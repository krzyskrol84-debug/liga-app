{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liga",
  "version": "0.1.0",
  "identifier": "com.liga.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liga",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Liga",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "League of Legends local champion select assistant",
    "longDescription": "Local desktop assistant for League of Legends champion select, builds, runes and summoner spells.",
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Polish"
        ],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "startMenuFolder": "Liga"
      }
    }
  }
}
